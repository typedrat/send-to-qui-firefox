{
  "name": "send-to-qui",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun run build.ts",
    "watch": "bun run build.ts --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "web-ext lint --source-dir dist",
    "start": "bun run build && web-ext run --source-dir dist",
    "package": "bun run build && web-ext build --source-dir dist --overwrite-dest",
    "build:host": "bun build --compile --minify src/host/main.ts --outfile dist-host/send-to-qui-host",
    "install-host": "bun run build:host && bun run scripts/install-host.ts"
  },
  "dependencies": {
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/firefox-webext-browser": "143.0.1",
    "typescript": "7.0.2",
    "web-ext": "10.8.0"
  }
}
